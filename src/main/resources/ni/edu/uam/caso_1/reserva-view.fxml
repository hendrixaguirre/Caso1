<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="593.0" prefWidth="442.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.caso_1.controller.ReservaController">
   <children>
      <Label layoutX="25.0" layoutY="28.0" text="RESERVA DE ENTRADAS">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <Separator layoutX="1.0" layoutY="76.0" prefHeight="13.0" prefWidth="441.0" />
      <GridPane gridLinesVisible="true" layoutX="34.0" layoutY="107.0" prefHeight="110.0" prefWidth="372.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label alignment="CENTER" prefHeight="17.0" prefWidth="126.0" text="Disponibles:" />
            <Label alignment="CENTER" prefHeight="17.0" prefWidth="141.0" text="Confirmadas:" GridPane.columnIndex="1" />
            <Label alignment="CENTER" prefHeight="17.0" prefWidth="128.0" text="Rechazadas:" GridPane.columnIndex="2" />
            <Label fx:id="lblDisponibles" alignment="CENTER" prefHeight="17.0" prefWidth="126.0" text="20" GridPane.rowIndex="1" />
            <Label fx:id="lblConfirmadas" alignment="CENTER" prefHeight="17.0" prefWidth="128.0" text="0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label fx:id="lblRechazadas" alignment="CENTER" prefHeight="17.0" prefWidth="128.0" text="0" GridPane.columnIndex="2" GridPane.rowIndex="1" />
         </children>
      </GridPane>
      <HBox layoutX="33.0" layoutY="231.0" prefHeight="44.0" prefWidth="372.0" spacing="10.0">
         <children>
            <Button fx:id="btnIniciar" mnemonicParsing="false" onAction="#iniciarSimulacion" prefHeight="36.0" prefWidth="73.0" text="Iniciar" />
            <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#cancelarSimulacion" prefHeight="36.0" prefWidth="76.0" text="Cancelar" />
            <Label fx:id="lblEstado" prefHeight="34.0" prefWidth="199.0" text="Listo para empezar" />
         </children>
      </HBox>
      <Separator layoutX="1.0" layoutY="284.0" prefHeight="13.0" prefWidth="441.0" />
      <Label layoutX="24.0" layoutY="304.0" text="Registro de entradas">
         <font>
            <Font name="System Bold" size="15.0" />
         </font>
      </Label>
      <TextArea fx:id="txtRegistro" editable="false" layoutX="25.0" layoutY="333.0" prefHeight="200.0" prefWidth="382.0" wrapText="true" />
      <Button fx:id="btnSalir" layoutX="24.0" layoutY="546.0" mnemonicParsing="false" onAction="#salirSistema" prefHeight="25.0" prefWidth="73.0" text="Salir" />
   </children>
</AnchorPane>
